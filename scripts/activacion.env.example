# Agregar en Render > Environment sin sustituir claves existentes.
AI_ENABLED=true
AI_AUTOMATIC_GRADING=true
PAYMENT_SIMULATION_ENABLED=true
SESSION_DRIVER=file
CACHE_STORE=file

# GROQ_API_KEY y GROQ_MODEL: conservar los que ya usa la generación de preguntas.
# APP_KEY y STUDENT_PIN_PEPPER: CONSERVAR exactamente sus valores actuales.
# Cambiarlos impediría validar los PIN existentes.

# Mantener false en el plan Free. Activar solo tras configurar y probar
# Supabase Advanced MFA Phone y el proveedor SMS; ambos tienen costos reales.
SUPABASE_MFA_PHONE_ENABLED=false

# Los respaldos externos requieren configuración de operación independiente.
BACKUP_ENABLED=false
