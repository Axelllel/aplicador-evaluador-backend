APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Proxies de confianza (IP o rangos separados por comas). Sin definir o * = todos (solo para pruebas).
# TRUSTED_PROXIES=*
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Opcional, pero recomendado: secreto independiente para proteger los PIN de alumnos.
# Si se deja vacío, Laravel usa APP_KEY; no la cambies sin plan de rotacion de PIN.
STUDENT_PIN_PEPPER=

# IA: configurar solo en el servidor; nunca en VITE_* ni en la app móvil.
AI_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_DAILY_REQUEST_LIMIT=20
AI_GLOBAL_DAILY_REQUEST_LIMIT=100
AI_GLOBAL_DAILY_TOKEN_LIMIT=150000

AI_AUTOMATIC_GRADING=true
# Activar después de configurar Phone MFA y proveedor SMS en Supabase.
SUPABASE_MFA_PHONE_ENABLED=false

# Operación: conexiones separadas, nunca usar el rol de la API para elevar privilegios.
BACKUP_ENABLED=false
BACKUP_DATABASE_URL=
BACKUP_RESTORE_DATABASE_URL=
BACKUP_SSLMODE=require
BACKUP_DIRECTORY=
BACKUP_GNUPGHOME=
BACKUP_PG_DUMP=pg_dump
BACKUP_PG_DUMPALL=pg_dumpall
BACKUP_PG_RESTORE=pg_restore

BACKUP_KEY_FILE=
